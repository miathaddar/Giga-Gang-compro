// Optimized Maze Follower with Kalman Filter + PID Control
// Features: Kalman filtering for ultrasonics, PID for turning and wall following

#include <Wire.h>
#include <MPU6050.h>

// ==================== HARDWARE PINS ====================
MPU6050 mpu;

// Ultrasonic sensors
const int trig_front = 9, echo_front = 10;
const int trig_left = 11, echo_left = 12;
const int trig_right = 7, echo_right = 8;

// Motor pins
const int motor_left_fwd = 3, motor_left_bck = 4;
const int motor_right_fwd = 5, motor_right_bck = 6;

// ==================== KALMAN FILTER CLASS ====================
class KalmanFilter {
private:
  float Q; // Process noise covariance
  float R; // Measurement noise covariance
  float P; // Estimation error covariance
  float K; // Kalman gain
  float X; // Estimated value
  
public:
  KalmanFilter(float process_noise, float measurement_noise, float initial_value) {
    Q = process_noise;
    R = measurement_noise;
    P = 1.0;
    X = initial_value;
  }
  
  float update(float measurement) {
    // Prediction
    P = P + Q;
    
    // Update
    K = P / (P + R);
    X = X + K * (measurement - X);
    P = (1 - K) * P;
    
    return X;
  }
  
  float getValue() { return X; }
  void reset(float value) { X = value; P = 1.0; }
};

// Kalman filters for each ultrasonic sensor
KalmanFilter kf_front(0.5, 2.0, 50.0);  // Q, R, initial_value
KalmanFilter kf_left(0.5, 2.0, 50.0);
KalmanFilter kf_right(0.5, 2.0, 50.0);

// ==================== PID CONTROLLER CLASS ====================
class PIDController {
private:
  float Kp, Ki, Kd;
  float integral, prev_error;
  float output_min, output_max;
  unsigned long last_time;
  
public:
  PIDController(float p, float i, float d, float min_out, float max_out) {
    Kp = p; Ki = i; Kd = d;
    output_min = min_out;
    output_max = max_out;
    reset();
  }
  
  float compute(float setpoint, float measured_value) {
    unsigned long now = millis();
    float dt = (now - last_time) / 1000.0;
    if (dt <= 0) dt = 0.01;
    last_time = now;
    
    // Calculate error
    float error = setpoint - measured_value;
    
    // Integral with anti-windup
    integral += error * dt;
    integral = constrain(integral, output_min / Ki, output_max / Ki);
    
    // Derivative
    float derivative = (error - prev_error) / dt;
    prev_error = error;
    
    // PID output
    float output = Kp * error + Ki * integral + Kd * derivative;
    return constrain(output, output_min, output_max);
  }
  
  void reset() {
    integral = 0;
    prev_error = 0;
    last_time = millis();
  }
  
  void setTunings(float p, float i, float d) {
    Kp = p; Ki = i; Kd = d;
  }
};

// PID controllers
PIDController pid_turn(3.5, 0.8, 1.2, -255, 255);      // For precise turning
PIDController pid_wall(4.0, 0.2, 1.5, -80, 80);        // For wall following

// ==================== IMU VARIABLES ====================
float yaw = 0.0;
float gyro_z_offset = 0.0;
unsigned long last_time = 0;

// ==================== CONFIGURATION ====================
const float WALL_DISTANCE = 3.0;     // Target distance from left wall (cm)
const float FRONT_THRESHOLD = 5.0;   // Stop distance (cm)
const float NO_WALL_THRESHOLD = 25.0; // Distance considered "no wall"
const int BASE_SPEED = 120;           // Base motor speed (0-255)
const int TURN_SPEED = 140;           // Speed during turns
const float TURN_TOLERANCE = 3.0;     // Acceptable angle error (degrees)

// ==================== SETUP ====================
void setup() {
  Serial.begin(9600);
  Wire.begin();
  
  // Initialize MPU6050
  Serial.println("Initializing IMU...");
  mpu.initialize();
  
  if (!mpu.testConnection()) {
    Serial.println("IMU connection failed!");
    while(1);
  }
  Serial.println("IMU connected!");
  
  // Calibrate gyroscope
  Serial.println("Calibrating gyroscope... Keep still for 3 seconds!");
  delay(1000);
  calibrateGyro();
  
  // Setup pins
  pinMode(trig_front, OUTPUT); pinMode(echo_front, INPUT);
  pinMode(trig_left, OUTPUT);  pinMode(echo_left, INPUT);
  pinMode(trig_right, OUTPUT); pinMode(echo_right, INPUT);
  
  pinMode(motor_left_fwd, OUTPUT);  pinMode(motor_left_bck, OUTPUT);
  pinMode(motor_right_fwd, OUTPUT); pinMode(motor_right_bck, OUTPUT);
  
  last_time = millis();
  Serial.println("=== Maze Solver Ready ===");
  delay(2000);
}

// ==================== MAIN LOOP ====================
void loop() {
  updateHeading();
  
  // Get filtered distances
  float dist_front = getFilteredDistance(trig_front, echo_front, kf_front);
  float dist_left = getFilteredDistance(trig_left, echo_left, kf_left);
  float dist_right = getFilteredDistance(trig_right, echo_right, kf_right);
  
  // Debug output
  printStatus(dist_front, dist_left, dist_right);
  
  // LEFT-HAND RULE with improved logic
  if (dist_left > NO_WALL_THRESHOLD) {
    // No left wall - turn left to find it
    Serial.println(">>> Turn LEFT (no left wall)");
    turnToAngle(yaw - 90.0);
    moveForwardDistance(10.0); // Move a bit forward after turn
  }
  else if (dist_front < FRONT_THRESHOLD) {
    // Obstacle ahead - turn right
    Serial.println(">>> Turn RIGHT (obstacle ahead)");
    turnToAngle(yaw + 90.0);
  }
  else {
    // Follow left wall with PID control
    moveForwardWithPID(dist_left);
  }
  
  delay(50);
}

// ==================== GYROSCOPE CALIBRATION ====================
void calibrateGyro() {
  const int samples = 1000;
  long sum = 0;
  
  for (int i = 0; i < samples; i++) {
    int16_t gz;
    mpu.getRotationZ(&gz);
    sum += gz;
    delay(3);
  }
  
  gyro_z_offset = sum / (float)samples;
  Serial.print("Gyro Z offset: ");
  Serial.println(gyro_z_offset);
}

// ==================== IMU HEADING UPDATE ====================
void updateHeading() {
  unsigned long current_time = millis();
  float dt = (current_time - last_time) / 1000.0;
  if (dt <= 0) dt = 0.01;
  
  // Read gyroscope with offset compensation
  int16_t gz;
  mpu.getRotationZ(&gz);
  float gyro_z = (gz - gyro_z_offset) / 131.0; // Convert to deg/s
  
  // Integrate to get angle
  yaw += gyro_z * dt;
  
  // Normalize to 0-360
  while (yaw < 0) yaw += 360.0;
  while (yaw >= 360.0) yaw -= 360.0;
  
  last_time = current_time;
}

// ==================== FILTERED DISTANCE READING ====================
float getFilteredDistance(int trig, int echo, KalmanFilter &kf) {
  float raw_distance = getDistanceRaw(trig, echo);
  
  // Handle invalid readings
  if (raw_distance > 200.0 || raw_distance < 2.0) {
    return kf.getValue(); // Return last valid estimate
  }
  
  return kf.update(raw_distance);
}

float getDistanceRaw(int trig, int echo) {
  digitalWrite(trig, LOW);
  delayMicroseconds(2);
  digitalWrite(trig, HIGH);
  delayMicroseconds(10);
  digitalWrite(trig, LOW);
  
  float duration = pulseIn(echo, HIGH, 30000);
  if (duration == 0) return 999.0;
  
  return (duration * 0.034) / 2.0;
}

// ==================== PID TURNING ====================
void turnToAngle(float target) {
  // Normalize target angle
  while (target < 0) target += 360.0;
  while (target >= 360.0) target -= 360.0;
  
  pid_turn.reset();
  unsigned long turn_start = millis();
  
  while (millis() - turn_start < 5000) { // 5 second timeout
    updateHeading();
    
    float error = angleError(target, yaw);
    
    if (abs(error) < TURN_TOLERANCE) {
      stopMotors();
      delay(200);
      return;
    }
    
    float correction = pid_turn.compute(target, yaw);
    
    // Apply motor correction
    if (correction > 0) { // Turn right
      setMotors(-correction, correction);
    } else { // Turn left
      setMotors(-correction, correction);
    }
    
    delay(10);
  }
  
  stopMotors();
  Serial.println("Turn timeout!");
}

// Calculate shortest angle difference (handles wraparound)
float angleError(float target, float current) {
  float error = target - current;
  
  if (error > 180.0) error -= 360.0;
  if (error < -180.0) error += 360.0;
  
  return error;
}

// ==================== PID WALL FOLLOWING ====================
void moveForwardWithPID(float left_distance) {
  float correction = pid_wall.compute(WALL_DISTANCE, left_distance);
  
  int left_speed = BASE_SPEED - correction;
  int right_speed = BASE_SPEED + correction;
  
  // Constrain speeds
  left_speed = constrain(left_speed, 0, 255);
  right_speed = constrain(right_speed, 0, 255);
  
  setMotors(left_speed, right_speed);
}

// ==================== MOVE FORWARD DISTANCE ====================
void moveForwardDistance(float distance_cm) {
  // Simple time-based forward movement
  // For encoder-based distance, replace with encoder counting
  int move_time = distance_cm * 10; // Rough estimate: 10ms per cm (tune this!)
  
  setMotors(BASE_SPEED, BASE_SPEED);
  delay(move_time);
  stopMotors();
}

// ==================== MOTOR CONTROL ====================
void setMotors(int left_speed, int right_speed) {
  // Left motor
  if (left_speed >= 0) {
    analogWrite(motor_left_fwd, left_speed);
    analogWrite(motor_left_bck, 0);
  } else {
    analogWrite(motor_left_fwd, 0);
    analogWrite(motor_left_bck, -left_speed);
  }
  
  // Right motor
  if (right_speed >= 0) {
    analogWrite(motor_right_fwd, right_speed);
    analogWrite(motor_right_bck, 0);
  } else {
    analogWrite(motor_right_fwd, 0);
    analogWrite(motor_right_bck, -right_speed);
  }
}

void stopMotors() {
  analogWrite(motor_left_fwd, 0);
  analogWrite(motor_left_bck, 0);
  analogWrite(motor_right_fwd, 0);
  analogWrite(motor_right_bck, 0);
}

// ==================== DEBUG OUTPUT ====================
void printStatus(float f, float l, float r) {
  Serial.print("Yaw:");
  Serial.print(yaw, 1);
  Serial.print("° | Front:");
  Serial.print(f, 1);
  Serial.print(" Left:");
  Serial.print(l, 1);
  Serial.print(" Right:");
  Serial.println(r, 1);
}
